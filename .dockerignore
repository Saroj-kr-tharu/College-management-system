# Git
.git
.gitignore

# Environment files
.env
.env.*
!.env.example
**/.env
**/.env.*

# Node modules
node_modules
**/node_modules

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist
build
.next
out

# IDE and Editor files
.idea
.vscode
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# Docker files (no need to copy into image)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Kubernetes configs
k8s/

# Test files
coverage
.nyc_output
*.test.ts
*.spec.ts
__tests__

# Documentation
README.md
*.md
docs/

# Uploads folder (should be mounted as volume)
**/uploads/*
!**/uploads/.gitkeep

# Package lock files (optional - uncomment if not needed)
# package-lock.json
# yarn.lock

# TypeScript build info
*.tsbuildinfo

# Temp files
tmp
temp
*.tmp
